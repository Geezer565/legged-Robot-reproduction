; Unit-test/development configuration for the joint 16D uncertainty only.
; Gamma is deliberately block diagonal: Gamma_in is entries 0..9 and
; Gamma_f is entries 10..15, so the two physical channels can be tuned apart.
adaptive_clf_mpc
{
  parameterization payload_inertial_10d_plus_wrench_6d
  enableParameterUpdate true
  enableAdaptiveDynamics true
  enableClfConstraint true
  minimumEstimatedTotalMass 1.0
  lambdaLinear { (0,0) 2.0 (1,1) 2.0 (2,2) 2.0 }
  lambdaAngular { (0,0) 1.5 (1,1) 1.5 (2,2) 1.5 }
  gamma {
    (0,0) 1.0 (1,1) 1.0 (2,2) 1.0 (3,3) 1.0 (4,4) 1.0
    (5,5) 1.0 (6,6) 1.0 (7,7) 1.0 (8,8) 1.0 (9,9) 1.0
    (10,10) 2.0 (11,11) 2.0 (12,12) 2.0
    (13,13) 0.5 (14,14) 0.5 (15,15) 0.5
  }
  kd { (0,0) 1.0 (1,1) 1.0 (2,2) 1.0 (3,3) 1.0 (4,4) 1.0 (5,5) 1.0 }
  initialParameterEstimate {
    (0,0) 0.0 (1,0) 0.0 (2,0) 0.0 (3,0) 0.0 (4,0) 0.0 (5,0) 0.0
    (6,0) 0.0 (7,0) 0.0 (8,0) 0.0 (9,0) 0.0 (10,0) 0.0 (11,0) 0.0
    (12,0) 0.0 (13,0) 0.0 (14,0) 0.0 (15,0) 0.0
  }
}
