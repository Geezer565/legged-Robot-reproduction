; Complete published ETH parameter structure:
; pi_u=[m,hx,hy,hz,Jxx,Jxy,Jxz,Jyy,Jyz,Jzz,Fx,Fy,Fz,Tx,Ty,Tz].
; The first 10 Gamma entries, Lambda, K_D, and zero initialization are
; published values. The paper does not publish Gamma for the final wrench
; block; unit gains below are explicit reconstruction choices, not claimed as
; author values. The equations and all matrix dimensions remain unchanged.
adaptive_clf_mpc {
  parameterization payload_inertial_10d_plus_wrench_6d
  adaptiveDynamicsForm paper_regressor_compensation
  enableParameterUpdate true
  enableAdaptiveDynamics true
  enableClfConstraint true
  enableInputBiasCost false
  useSoftConstraint true
  softConstraintMu 0.1
  softConstraintDelta 5.0
  minimumEstimatedTotalMass 1.0
  enableEncodedReferenceDerivatives true
  enableGaitPhaseBaselineCorrection false
  enableCompositePhaseBaselineCorrection false
  lambdaLinear { (0,0) 5.0 (1,1) 5.0 (2,2) 5.0 }
  lambdaAngular { (0,0) 5.0 (1,1) 5.0 (2,2) 5.0 }
  gamma { (0,0) 5.0 (1,1) 1.0 (2,2) 1.0 (3,3) 1.0 (4,4) 0.01 (5,5) 0.01 (6,6) 0.01 (7,7) 0.01 (8,8) 0.01 (9,9) 0.01 (10,10) 1.0 (11,11) 1.0 (12,12) 1.0 (13,13) 1.0 (14,14) 1.0 (15,15) 1.0 }
  kd { (0,0) 50.0 (1,1) 50.0 (2,2) 50.0 (3,3) 80.0 (4,4) 80.0 (5,5) 80.0 }
  initialParameterEstimate { (0,0) 0.0 (1,0) 0.0 (2,0) 0.0 (3,0) 0.0 (4,0) 0.0 (5,0) 0.0 (6,0) 0.0 (7,0) 0.0 (8,0) 0.0 (9,0) 0.0 (10,0) 0.0 (11,0) 0.0 (12,0) 0.0 (13,0) 0.0 (14,0) 0.0 (15,0) 0.0 }
}