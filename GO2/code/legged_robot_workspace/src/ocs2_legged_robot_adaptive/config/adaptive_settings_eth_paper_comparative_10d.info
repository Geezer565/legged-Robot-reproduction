; Minniti et al., RA-L 2022, Sec. V-A comparative experiment.
; Every numeric adaptive/CLF gain published in the paper is copied verbatim.
; The relaxed-barrier continuation values are OCS2 implementation settings;
; the paper states the method but does not publish mu/delta.
adaptive_clf_mpc {
  parameterization payload_inertial_10d
  adaptiveDynamicsForm paper_regressor_compensation
  enableParameterUpdate true
  enableAdaptiveDynamics true
  enableClfConstraint true
  enableInputBiasCost false
  useSoftConstraint true
  softConstraintMu 0.1
  softConstraintDelta 5.0
  minimumEstimatedTotalMass 1.0
  enableEncodedReferenceDerivatives true
  enableGaitPhaseBaselineCorrection false
  enableCompositePhaseBaselineCorrection false
  lambdaLinear { (0,0) 5.0 (1,1) 5.0 (2,2) 5.0 }
  lambdaAngular { (0,0) 5.0 (1,1) 5.0 (2,2) 5.0 }
  gamma { (0,0) 5.0 (1,1) 1.0 (2,2) 1.0 (3,3) 1.0 (4,4) 0.01 (5,5) 0.01 (6,6) 0.01 (7,7) 0.01 (8,8) 0.01 (9,9) 0.01 }
  kd { (0,0) 50.0 (1,1) 50.0 (2,2) 50.0 (3,3) 80.0 (4,4) 80.0 (5,5) 80.0 }
  initialParameterEstimate { (0,0) 0.0 (1,0) 0.0 (2,0) 0.0 (3,0) 0.0 (4,0) 0.0 (5,0) 0.0 (6,0) 0.0 (7,0) 0.0 (8,0) 0.0 (9,0) 0.0 }
}